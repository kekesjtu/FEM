  "clang-format.executable": "E:\\msys64\\ucrt64\\bin\\clang-format.exe",
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "[c]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "cmake.configureOnOpen": true,
  "cmake.useCMakePresets": "always",
  "cmake.allowCommentsInPresetsFile": true,
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
  "cmake.debugConfig": {
    "name": "Debug FEM Solution",
    "type": "cppdbg",
    "request": "launch",
    "program": "${workspaceFolder}/build/bin/FEM_solution.exe",
    "args": [],
    "stopAtEntry": false,
    "cwd": "${workspaceFolder}",
    "environment": [],
    "externalConsole": false,
    "MIMode": "gdb",
    "miDebuggerPath": "E:\\msys64\\ucrt64\\bin\\gdb.exe",
    "setupCommands": [
      {
        "description": "Enable pretty-printing for gdb",
        "text": "-enable-pretty-printing",
        "ignoreFailures": true
      }
    ]
  }
