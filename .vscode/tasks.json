{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build FEM Project",
      "type": "cppbuild",
      "command": "E:\\msys64\\ucrt64\\bin\\g++.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "-std=c++17",
        "-I${workspaceFolder}/include",
        "-I${workspaceFolder}/third_party",
        "${workspaceFolder}/src/main.cpp",
        "${workspaceFolder}/src/fem_solver.cpp",
        "${workspaceFolder}/src/shape_functions.cpp",
        "${workspaceFolder}/src/gauss_quadrature.cpp",
        "${workspaceFolder}/src/geometry_mapping.cpp",
        "${workspaceFolder}/src/error_analysis.cpp",
        "${workspaceFolder}/src/config.cpp",
        "${workspaceFolder}/src/comsol_mesh_importer.cpp",
        "${workspaceFolder}/src/vtk_output.cpp",
        "-o",
        "${workspaceFolder}/build/FEM_solution.exe"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "detail": "编译整个有限元求解器项目"
    },
    {
      "label": "Run FEM Solution",
      "type": "shell",
      "command": "${workspaceFolder}/build/FEM_solution.exe",
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c", "chcp 65001 &&"]
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new"
      },
      "dependsOn": "Build FEM Project",
      "detail": "运行FEM求解器"
    },
    {
      "type": "cppbuild",
      "label": "C/C++: g++.exe 生成活动文件",
      "command": "E:\\msys64\\ucrt64\\bin\\g++.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "-std=c++17",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "调试器生成的任务。"
    }
  ]
}
