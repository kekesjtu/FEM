{
  "problem_name": "sphere_uniform_source_3d",
  "description": "三维球域均匀源项问题（带解析解）",
  "dimension": 3,
  "mesh_file": "mesh_data/sphere_tet_mesh.mphtxt",
  "material_library_file": "materials_example.json",
  
  "domain_materials": {
    "1": "aluminum"
  },
  
  "fields": {
    "thermal": {
      "source": {
        "type": "constant",
        "value": 10.0
      },
      "boundary_conditions": [
        {
          "entities": "all",
          "type": "Dirichlet",
          "value": 0.0
        }
      ],
      "exact_solution": {
        "u": {
          "type": "expression",
          "formula": "(5.0/3.0) * (1 - x*x - y*y - z*z)",
          "variables": ["x", "y", "z"]
        },
        "grad_x": {
          "type": "expression",
          "formula": "-(10.0/3.0) * x",
          "variables": ["x"]
        },
        "grad_y": {
          "type": "expression",
          "formula": "-(10.0/3.0) * y",
          "variables": ["y"]
        },
        "grad_z": {
          "type": "expression",
          "formula": "-(10.0/3.0) * z",
          "variables": ["z"]
        }
      }
    }
  },
  
  "solver": {
    "solver_type": "CG",
    "preconditioner_type": "DiagonalPreconditioner",
    "tolerance": 1e-8,
    "max_iterations": 1000
  }
}
